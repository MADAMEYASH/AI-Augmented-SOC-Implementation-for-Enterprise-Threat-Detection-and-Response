# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Configuration (Injected by platform)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="aegis_soc"
SQL_USER="ai_studio_user"
SQL_PASSWORD="your-strong-password"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="your-admin-password"

# SOC Operational Mode
NODE_ENV="production"
ALLOW_ANONYMOUS_SOC="false"
